# Copy to .env; never commit real credentials.
GEMINI_API_KEY=
# Verified stable low-cost structured-output model on 2026-10-07; can be changed.
GEMINI_MODEL=gemini-3.1-flash-lite
TELEGRAM_BOT_TOKEN=
# Public channel: @your_channel. Private channel: numeric -100... ID.
TELEGRAM_CHAT_ID=

NEWS_LOOKBACK_HOURS=24
MAX_ARTICLES_FOR_AI=40
MAX_DAILY_ARTICLES=8
MIN_RELEVANCE_SCORE=6
MIN_FINAL_SCORE=6.5
AI_BATCH_SIZE=8
AI_BATCH_DELAY_SECONDS=15
HTTP_TIMEOUT_SECONDS=30
REQUEST_ATTEMPTS=3
MAX_RETRY_DELAY_SECONDS=60
DEDUP_SIMILARITY=0.86
DIVERSITY_SCORE_GAP=0.6
STATE_RETENTION_DAYS=30
MAX_FEED_ENTRIES=200
DATABASE_PATH=data/news.db
# Safe default for local development. Set false to publish locally.
DRY_RUN=true

WEIGHT_AJET_RELEVANCE=0.35
WEIGHT_BUSINESS_IMPACT=0.25
WEIGHT_NOVELTY=0.15
WEIGHT_FEASIBILITY=0.15
WEIGHT_URGENCY=0.10
